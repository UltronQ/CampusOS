# Public Supabase project values (safe for the browser bundle).
# Never put the service-role key here or anywhere in frontend code.
# Copy the actual values from your Supabase project's Connect dialog.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys remain supported when the publishable key is empty.
VITE_SUPABASE_ANON_KEY=
