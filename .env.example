# Public Supabase project values (safe for the browser bundle).
# Never put the service-role key here or anywhere in frontend code.
# A Supabase publishable key can be supplied as VITE_SUPABASE_PUBLISHABLE_KEY.
# Keep only the public key your project uses; legacy anon keys also work.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
